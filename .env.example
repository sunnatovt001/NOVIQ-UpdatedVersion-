# AI requests run through Firebase Functions.
# Do not put Gemini API keys in VITE_* frontend variables.

# Website URL resolution for local development and production deployments:
# In local dev: defaults to http://localhost:3000
# In production: configure PUBLIC_APP_URL or APP_URL (e.g. https://your-domain.com or Vercel URL)
PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
VITE_FUNCTIONS_REGION="us-central1"
# Firebase remains the production backend. Enable only in a separate MongoDB
# staging build served by server/src/main.mjs; this is not a database switch.
VITE_ENABLE_MONGO_STAGING="false"
# Enable only after Functions + indexes + a verified legacy backfill are deployed.
# Kept off while this project remains on the no-billing plan.
VITE_SERVER_METRICS_ENABLED="false"

# Admin permissions are granted on the server, not by frontend environment variables.

# VITE_TELEGRAM_BOT_USERNAME: Telegram bot username without @.
# Used only to open the bot from Profile. The bot token must stay server-side.
VITE_TELEGRAM_BOT_USERNAME="noviqq_bot"
