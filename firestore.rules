rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnerField() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.get("admin", false) == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("isAdmin", false) == true
        );
    }

    function isSafeDailyVisit() {
      let today = int((request.time.toMillis() + 18000000) / 86400000);
      let previousDay = resource.data.get("lastVisitDay", -1);
      let previous = resource.data.get("visitStreak", 0);
      let best = resource.data.get("bestVisitStreak", 0);
      let expected = previousDay == today ? previous : (previousDay == today - 1 ? previous + 1 : 1);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visitStreak", "bestVisitStreak", "lastVisitDay", "lastVisitAt"])
        && request.resource.data.lastVisitDay == today
        && request.resource.data.lastVisitAt == request.time
        && request.resource.data.visitStreak is int
        && request.resource.data.visitStreak == expected
        && request.resource.data.bestVisitStreak is int
        && request.resource.data.bestVisitStreak == (best > expected ? best : expected);
    }

    function clientProfileMutableKeys() {
      return [
        "displayName",
        "photoURL",
        "onboarded",
        "onboardingAnswers",
        "onboardingCompleted",
        "onboarding",
        "onboardingCompletedAt",
        "goals",
        "currentLevel",
        "showActionButtons",
        "settings"
      ];
    }

    function clientProfileCreateKeys() {
      return [
        "uid",
        "email",
        "displayName",
        "photoURL",
        "createdAt",
        "isAdmin",
        "onboarded",
        "onboardingAnswers",
        "onboardingCompleted",
        "onboarding",
        "onboardingCompletedAt",
        "goals",
        "currentLevel",
        "dailyTargetMinutes",
        "xp",
        "level",
        "levelName",
        "xpAwarded",
        "streak",
        "lastActive",
        "totalStudySeconds",
        "subscription",
        "usage",
        "settings",
        "showActionButtons"
      ];
    }

    function isDefaultClientSubscription() {
      return !("subscription" in request.resource.data)
        || (
          request.resource.data.subscription.keys().hasOnly(["plan", "status"])
          && request.resource.data.subscription.plan == "free"
          && request.resource.data.subscription.status == "active"
        );
    }

    function isEmptyClientUsage() {
      return !("usage" in request.resource.data)
        || request.resource.data.usage.keys().hasOnly([]);
    }

    function validOnboardingState() {
      return (!("onboardingCompleted" in request.resource.data) || request.resource.data.onboardingCompleted is bool)
        && (request.resource.data.get("onboardingCompleted", false) != true || (
          request.resource.data.onboarding is map
          && request.resource.data.onboarding.keys().hasAll(["goal", "profile", "challenge"])
          && request.resource.data.onboarding.keys().hasOnly(["goal", "profile", "challenge"])
          && request.resource.data.onboarding.goal in ["Prepare for IELTS", "Prepare for SAT", "Prepare for HSK", "Reach a CEFR level", "Improve school grades", "Prepare for university entrance", "Stay consistent with exam prep"]
          && request.resource.data.onboarding.profile in ["High school student", "University student", "IELTS learner", "SAT learner", "HSK learner", "CEFR learner", "University entrance candidate"]
          && request.resource.data.onboarding.challenge in ["Staying consistent", "Procrastination", "Distractions", "Organizing study materials", "Time management", "Remembering information", "Exam anxiety"]
          && request.resource.data.onboardingCompletedAt is timestamp
          && request.resource.data.onboardingCompletedAt <= request.time
        ));
    }

    function isSafeProfileCreate(userId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly(clientProfileCreateKeys())
        && request.resource.data.uid == userId
        && (!("createdAt" in request.resource.data) || request.resource.data.createdAt is string)
        && (!("isAdmin" in request.resource.data) || request.resource.data.isAdmin == false)
        && (!("xp" in request.resource.data) || request.resource.data.xp == 0)
        && (!("level" in request.resource.data) || request.resource.data.level == 1)
        && (!("levelName" in request.resource.data) || request.resource.data.levelName == "Novice Student")
        && (!("streak" in request.resource.data) || request.resource.data.streak == 0)
        && (!("xpAwarded" in request.resource.data) || request.resource.data.xpAwarded.keys().hasOnly([]))
        && (!("totalStudySeconds" in request.resource.data) || request.resource.data.totalStudySeconds == 0)
        && isDefaultClientSubscription()
        && isEmptyClientUsage()
        && validOnboardingState();
    }

    function isSafeProfileUpdate() {
      // The diff includes additions and removals, so protected fields remain
      // immutable even on legacy profiles missing isAdmin/subscription/usage.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientProfileMutableKeys())
        && validOnboardingState()
        && (resource.data.get("onboardingCompleted", false) != true || request.resource.data.get("onboardingCompleted", false) == true);
    }

    function isPendingSubscriptionRequest() {
      return request.resource.data.status == "pending"
        && request.resource.data.keys().hasOnly(["action", "status", "currentPlan", "currentStatus", "createdAt", "syncStatus", "syncedAt"])
        && request.resource.data.action in ["cancel_renewal", "update_billing"]
        && (!("syncStatus" in request.resource.data) || request.resource.data.syncStatus in ["pending", "synced", "failed"]);
    }

    function hasValidSyncStatus() {
      return !("syncStatus" in request.resource.data)
        || request.resource.data.syncStatus in ["pending", "synced", "failed"];
    }

    function isProgressEventCreate(userId, eventId) {
      return isOwner(userId)
        && request.resource.data.keys().hasOnly(["type", "sessionId", "dayKey", "awards", "rawXp", "activity", "proposedProgressPatch", "createdAt", "syncStatus", "syncedAt", "status"])
        && request.resource.data.type in ["daily_activity", "xp_award", "study_session"]
        && request.resource.data.createdAt is string
        && (request.resource.data.type != "study_session"
          || (request.resource.data.sessionId is string && eventId == "session-" + request.resource.data.sessionId))
        && (!("status" in request.resource.data) || request.resource.data.status == "pending")
        && (!("rawXp" in request.resource.data) || (request.resource.data.rawXp is number && request.resource.data.rawXp >= 0 && request.resource.data.rawXp <= 30))
        && hasValidSyncStatus();
    }

    function isAnalyticsEventCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasOnly(["userId", "eventType", "xp", "details", "page", "createdAt", "syncStatus", "syncedAt"])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventType is string
        && request.resource.data.eventType.matches('^[a-z_]{1,64}$')
        && (!("xp" in request.resource.data) || request.resource.data.xp <= 500)
        && hasValidSyncStatus();
    }

    function onlySyncMetadataChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["syncStatus", "syncedAt"])
        && hasValidSyncStatus();
    }

    // Default deny. Every working app path is explicitly opened below.
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile. Server-owned fields cannot be changed by the client.
    match /users/{userId} {
      allow create: if isSafeProfileCreate(userId) || isAdmin();
      allow read: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && (isSafeProfileUpdate() || isSafeDailyVisit())) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admin collection group reads for Founder Control Center.
    match /{path=**}/studySessions/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{path=**}/progressEvents/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{path=**}/notebookNotes/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{path=**}/notebookMessages/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{path=**}/tutorMessages/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{path=**}/decks/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{path=**}/trusted/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{path=**}/subscriptionRequests/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{path=**}/subscriptionCheckouts/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // AI Tutor chat memory.
    match /users/{userId}/tutorMessages/{messageId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId);
    }

    // Decks and flashcards.
    match /users/{userId}/decks/{deckId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId);

      match /cards/{cardId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId);
      }
    }

    // Server-owned progression evidence and immutable daily snapshots.
    match /users/{userId}/xpDays/{dayId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }
    match /users/{userId}/recallEvidence/{cardId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // Private review state is separate from card content. Non-destructive v2 additions.
    match /users/{userId}/decks/{deckId}/reviews/{cardId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && request.resource.data.id == cardId
        && request.resource.data.reviewCount is number && request.resource.data.reviewCount >= 0
        && request.resource.data.dueAt is string;
      allow delete: if isOwner(userId);
    }
    match /users/{userId}/flashcardSessions/{sessionId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && request.resource.data.id == sessionId
        && request.resource.data.attempts is list && request.resource.data.attempts.size() <= 200
        && request.resource.data.cardIds is list && request.resource.data.cardIds.size() <= 200
        && request.resource.data.activeSeconds is number && request.resource.data.activeSeconds >= 0;
      allow delete: if isOwner(userId);
    }

    // NotebookLM-style workspace.
    match /users/{userId}/notebookNotes/{noteId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/notebookSources/{sourceId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/notebookMessages/{messageId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId);
    }

    // Realtime notification center.
    match /users/{userId}/notifications/{notificationId} {
      allow create, read, update, delete: if isOwner(userId);
    }

    // Dashboard journals, roadmap tasks, and user-scoped session history.
    match /users/{userId}/journals/{journalId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/roadmapTasks/{taskId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/studySessions/{sessionId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if false;
      allow update: if isOwner(userId) && onlySyncMetadataChanged();
      allow delete: if false;
    }

    match /users/{userId}/progressEvents/{eventId} {
      allow create: if isProgressEventCreate(userId, eventId);
      allow read: if isOwner(userId) || isAdmin();
      allow delete: if false;
      allow update: if isOwner(userId) && onlySyncMetadataChanged();
    }

    // Trusted server-owned progress. Cloud Functions/Admin SDK bypass rules for writes.
    match /users/{userId}/trusted/{docId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /promoCodes/{codeId} {
      allow read, write: if false;
      match /audit/{auditId} { allow read, write: if false; }
    }
    match /users/{userId}/promoUsages/{codeId} {
      allow read, write: if false;
    }

    match /users/{userId}/subscriptionCheckouts/{checkoutId} {
      allow create: if false;
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) && onlySyncMetadataChanged();
      allow delete: if false;
    }

    match /users/{userId}/subscriptionRequests/{requestId} {
      allow create: if isOwner(userId) && isPendingSubscriptionRequest();
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) && onlySyncMetadataChanged();
      allow delete: if false;
    }

    function validPlanner(userId) {
      return request.resource.data.userId == userId && request.resource.data.version == 2
        && request.resource.data.persistenceVersion == 3 && request.resource.data.revision is string
        && request.resource.data.revision.size() > 0 && request.resource.data.tasks is list
        && request.resource.data.sessions is list && request.resource.data.subjects is list
        && request.resource.data.ready is bool && request.resource.data.sequence is int;
    }
    match /users/{userId}/planner/{plannerId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && (plannerId != 'smart-v2' ||
        validPlanner(userId) && request.resource.data.sequence == 1 && request.resource.data.previousRevision == null);
      allow update: if isOwner(userId) && (plannerId != 'smart-v2' ||
        validPlanner(userId) && request.resource.data.previousRevision == resource.data.get('revision', null)
        && request.resource.data.sequence == resource.data.get('sequence', 0) + 1
        && request.resource.data.revision != resource.data.get('revision', null));
      allow delete: if isOwner(userId) && plannerId != 'smart-v2';
    }
    match /users/{userId}/proExperience/{documentId} {
      allow read, create, update, delete: if isOwner(userId);
    }
    match /users/{userId}/proReflections/{documentId} {
      allow read, create, update, delete: if isOwner(userId);
    }
    match /users/{userId}/proEvents/{documentId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/plannerHistory/{revisionId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId
        && request.resource.data.plan.userId == userId
        && request.resource.data.plan.revision == get(/databases/$(database)/documents/users/$(userId)/planner/smart-v2).data.revision;
      allow update, delete: if false;
    }

    match /users/{userId}/joinedCommunities/{communityId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/friendInvites/{inviteId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/friends/{friendId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /communities/{communityId} {
      allow read: if isSignedIn();
      allow write: if false;
      match /members/{memberId} {
        allow read: if isOwner(memberId) || isAdmin();
        allow write: if false;
      }
      match /messages/{messageId} {
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
        allow write: if false;
      }
    }

    match /analytics/{docId} {
      allow write: if false;
      allow read: if isAdmin();
    }

    match /analyticsUsers/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /analyticsEvents/{eventId} {
      allow create: if isAnalyticsEventCreate();
      allow read: if isAdmin();
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && onlySyncMetadataChanged();
      allow delete: if false;
    }


    // Legacy root collections kept for older pages that still store userId.
    match /studyPlans/{planId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update, delete: if false;
    }

    match /notes/{noteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update, delete: if false;
    }

    match /decks/{deckId}/flashcards/{cardId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update, delete: if false;
    }

    match /studySessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update, delete: if false;
    }

    match /accountabilityRooms/{roomId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isOwnerField();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
