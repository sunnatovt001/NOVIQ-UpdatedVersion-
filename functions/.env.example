# Set FIREBASE_SERVICE_ACCOUNT_JSON in Vercel Settings > Environment Variables.
# Do not commit a service-account file or put its contents in any VITE_ variable.
PUBLIC_APP_URL="https://noviqupdated.vercel.app"
# Vercel sends Authorization: Bearer <CRON_SECRET> for the daily notification job.
CRON_SECRET=""

# Trusted payment adapter; checkout is disabled until these are configured.
