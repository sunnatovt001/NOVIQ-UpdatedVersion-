# Server only. Never use a VITE_ prefix or commit actual credentials.
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_PASSWORD@REPLACE_CLUSTER/
MONGODB_DATABASE=noviq_staging
NOVIQ_DATA_BACKEND=firestore
# A separate collection namespace for candidate-deployment verification.
MONGODB_COLLECTION_PREFIX=
MONGO_FILE_SIGNING_KEY=
APP_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
PORT=3001
# Staging only: do not enable in production before current data import and UI verification.
NOVIQ_MONGO_NOTEBOOK_API=false
NOVIQ_MONGO_PLANNER_API=false
NOVIQ_MONGO_PROFILE_API=false
NOVIQ_MONGO_FLASHCARDS_API=false
# Keep Firebase Auth for email/Google login; verify identities before Mongo sessions.
NOVIQ_FIREBASE_IDENTITY=false
# Encrypted asynchronous backup; enable only after baseline/cutover verification.
# Keep this 64-hex-character key outside both databases and back it up securely.
NOVIQ_FIREBASE_MIRROR=false
FIREBASE_MIRROR_ENCRYPTION_KEY=
FIREBASE_MIRROR_NAMESPACE=noviq_staging
# Worker only: use an authorized service account for the original Firebase project.
FIREBASE_SERVICE_ACCOUNT_JSON=
TELEGRAM_BOT_USERNAME=noviqq_bot
# Server-only token from your own BotFather settings; never expose via VITE_*.
TELEGRAM_BOT_TOKEN=
