{
  "name": "noviq-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "start:local": "node --env-file=.env src/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:atlas": "node --env-file=.env scripts/check-atlas.mjs",
    "migration:status": "node --env-file=.env scripts/migration-status.mjs"
  },
  "overrides": { "uuid": "^11.1.1" },
  "dependencies": {
    "firebase-admin": "13.10.0",
    "firebase-scrypt": "2.2.0",
    "mongodb": "7.7.0"
  }
}
