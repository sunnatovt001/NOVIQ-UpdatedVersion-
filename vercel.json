{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci && npm ci --prefix functions && npm ci --prefix server",
  "buildCommand": "npm run verify && node scripts/production-readiness.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/rpc.js": {
      "maxDuration": 120
    },
    "api/telegram.js": {
      "maxDuration": 120
    },
    "api/data.js": {
      "maxDuration": 120
    },
    "api/files.js": {
      "maxDuration": 120
    },
    "api/maintenance.js": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/telegram?cron=1",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/maintenance",
      "schedule": "15 16 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
